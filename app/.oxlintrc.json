{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["e2e/**", "playwright-report/**", "test-results/**"],
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": [
        "src/components/**",
        "src/layout/**",
        "src/lib/**",
        "src/api/**",
        "src/config/**",
        "src/domain/**",
        "src/hooks/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*", "@/features/**", "@/app/*", "@/app/**"],
                "message": "Dependency direction is app -> features -> shared. Shared layers must not import from a feature or from app. Move the shared piece down, or compose it higher up."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/*", "@/app/**"],
                "message": "Features must not import from app (the composition root). Expose a public API from the feature's index.ts instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
