{
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://api-gateway-216098834386.us-central1.run.app/auth/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://api-gateway-216098834386.us-central1.run.app/admin/:path*"
    },
    {
      "source": "/content/:path*",
      "destination": "https://api-gateway-216098834386.us-central1.run.app/content/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
