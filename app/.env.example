# nxClip Admin — environment
#
# Defaults (no .env needed): the app runs against the LIVE gateway.
# In dev, /auth and /admin are proxied to the gateway by vite.config.ts,
# so no CORS is required locally.

# --- Live / production ---
# Point the client at a cross-origin gateway (requires CORS on the gateway).
# Leave unset in dev to use the same-origin Vite proxy.
# VITE_API_URL=https://api-gateway-216098834386.us-central1.run.app

# --- Offline / mock mode ---
# Copy this file to `.env.local` and set this to run against MSW mocks
# instead of the live gateway (handy with no network / no backend).
# The e2e suite forces this on via playwright.config.ts.
# VITE_ENABLE_MOCKS=true
