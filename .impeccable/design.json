  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action.",
      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{font-family:var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);font-size:14px;font-weight:500;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius-lg);background:var(--action);color:var(--action-foreground)}.ds-primary:hover{background:var(--action-hover)}.ds-primary:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-primary:disabled{opacity:.5;pointer-events:none}.ds-primary{transition:background-color 150ms,transform 150ms}.ds-primary:active:not(:disabled){transform:translateY(1px)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting action with a shared neutral edge.",
      "html": "<button class=\"ds-secondary\">Refresh</button>",
      "css": ".ds-secondary{font-family:var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);font-size:14px;font-weight:500;height:32px;padding:0 10px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--secondary);color:var(--secondary-foreground)}.ds-secondary:hover{background:var(--elevated)}.ds-secondary:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-secondary:disabled{opacity:.5;pointer-events:none}.ds-secondary{transition:background-color 150ms,transform 150ms}.ds-secondary:active:not(:disabled){transform:translateY(1px)}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "description": "Shared outline button variant.",
      "html": "<button class=\"ds-outline\">View details</button>",
      "css": ".ds-outline{font:500 14px var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius-lg);border-color:var(--border);background:var(--background);color:var(--foreground)}.ds-outline:hover{background:var(--elevated)}.ds-outline:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-outline:disabled{opacity:.5;pointer-events:none}.ds-outline{transition:background-color 150ms,transform 150ms}.ds-outline:active:not(:disabled){transform:translateY(1px)}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "description": "Shared ghost button variant.",
      "html": "<button class=\"ds-ghost\">Cancel</button>",
      "css": ".ds-ghost{font:500 14px var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius-lg);background:transparent;color:var(--foreground)}.ds-ghost:hover{background:color-mix(in srgb,var(--muted) 50%,transparent)}.ds-ghost:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-ghost:disabled{opacity:.5;pointer-events:none}.ds-ghost{transition:background-color 150ms,transform 150ms}.ds-ghost:active:not(:disabled){transform:translateY(1px)}"
    },
    {
      "name": "Destructive button",
      "kind": "button",
      "description": "Shared destructive button variant.",
      "html": "<button class=\"ds-destructive\">Take down</button>",
      "css": ".ds-destructive{font:500 14px var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius-lg);background:color-mix(in srgb,var(--destructive) 20%,transparent);color:var(--destructive)}.ds-destructive:hover{background:color-mix(in srgb,var(--destructive) 30%,transparent)}.ds-destructive:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-destructive:disabled{opacity:.5;pointer-events:none}.ds-destructive{transition:background-color 150ms,transform 150ms}.ds-destructive:active:not(:disabled){transform:translateY(1px)}.ds-destructive:focus-visible{outline-color:color-mix(in srgb,var(--destructive) 40%,transparent);border-color:color-mix(in srgb,var(--destructive) 40%,transparent)}"
    },
    {
      "name": "Link button",
      "kind": "button",
      "description": "Shared link button variant.",
      "html": "<button class=\"ds-link\">View report</button>",
      "css": ".ds-link{font:500 14px var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius-lg);background:transparent;color:var(--primary);text-underline-offset:4px}.ds-link:hover{text-decoration:underline}.ds-link:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-link:disabled{opacity:.5;pointer-events:none}.ds-link{transition:background-color 150ms,transform 150ms}.ds-link:active:not(:disabled){transform:translateY(1px)}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "The field border follows the global border source.",
      "html": "<input class=\"ds-input\" aria-label=\"Search content\" placeholder=\"Search content\" />",
      "css": ".ds-input{font-family:var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);height:32px;padding:0 10px;border:1px solid var(--input);border-radius:var(--radius-lg);background:var(--secondary);color:var(--foreground)}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-input:disabled{opacity:.5}.ds-input{font-size:16px}.ds-input[aria-invalid=\"true\"]{border-color:var(--destructive)}@media(min-width:768px){.ds-input{font-size:14px}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Active navigation uses sidebar-accent and its foreground.",
      "html": "<nav aria-label=\"Example navigation\"><a class=\"ds-nav\" href=\"#overview\" aria-current=\"page\">Overview</a></nav>",
      "css": ".ds-nav{display:block;padding:10px;border-radius:var(--radius-lg);background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);font:500 13px var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);text-decoration:none}.ds-nav:hover{background:var(--elevated)}.ds-nav:focus-visible{outline:3px solid color-mix(in srgb,var(--ring) 50%,transparent);outline-offset:2px}.ds-nav:hover{background:var(--sidebar-accent)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Shared panel surface, border, and corner.",
      "html": "<section class=\"ds-panel\"><h2>Recent activity</h2><p>Review the latest operational records.</p></section>",
      "css": ".ds-panel{background:var(--card);color:var(--card-foreground);border:1px solid var(--border);border-radius:var(--radius-xl);padding:20px;font-family:var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif)}.ds-panel h2{font-size:var(--text-subtitle);font-weight:500;margin:0}.ds-panel p{font-size:var(--text-caption);color:var(--muted-foreground);margin:4px 0 0}"
    },
    {
      "name": "Status pill",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Illustrative status; runtime labels come from domain state.",
      "html": "<span class=\"ds-status\"><i></i>Published</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:4px;border-radius:9999px;padding:2px 8px;font:500 12px var(--font-sans,'General Sans', ui-sans-serif, system-ui, -apple-system, sans-serif);color:var(--success);background:color-mix(in srgb,var(--success) 14%,transparent)}.ds-status i{width:5px;height:5px;border-radius:50%;background:currentColor}.ds-status{height:20px;border:1px solid transparent;gap:6px}.ds-status i{width:6px;height:6px}"
    }
  ],
  "narrative": {
    "northStar": "The Mission Control Console",
    "overview": "nxClip Admin supports moderation, creator management, AI costs, and service health. The approved Overview establishes the shared visual language: charcoal canvas, navy surfaces, flat borders, compact controls, violet actions, and lavender navigation and focus. General Sans carries human-readable content; JetBrains Mono carries machine identifiers.",
    "keyCharacteristics": [
      "Tonal surfaces and fine borders make dense operational content readable.",
      "Violet actions, lavender emphasis, and explicit status labels have distinct roles.",
      "Shared tokens and components apply across every page and the synthetic preview."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "The violet family owns interaction: darker violet for filled actions, lighter lavender for text and focus. Status colors retain their own meanings.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** change shared theme values in `app/src/styles/index.css` and reuse existing components.",
      "**Do** keep global border aliases connected, including portaled overlays.",
      "**Do** distinguish darker violet actions from lavender text and focus.",
      "**Do** label synthetic fixtures and unavailable API data explicitly.",
      "**Do** validate responsive navigation, contained table overflow, and keyboard focus."
    ],
    "donts": [
      "**Don't** create a page-specific palette or duplicate the shared shell.",
      "**Don't** use status colors to identify neutral chart series.",
      "**Don't** present demonstration records or service states as live results.",
      "**Don't** hardcode component colors or radii that bypass the design tokens.",
      "**Don't** replace a shared component with a local copy to change its appearance."
    ]
  }
}
